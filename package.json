{
	"name": "midnight-8b",
	"version": "1.1.1-beta",
	"private": true,
	"type": "module",
	"description": "Полночь в 8-Б — браузерный хоррор о ночной школе на TypeScript и WebGL2 без внешних библиотек",
	"scripts": {
		"build": "tsc -p .",
		"vercel-build": "tsc -p . && node tools/vercel-build.mjs",
		"watch": "tsc -p . --watch",
		"serve": "node tools/serve.mjs",
		"start": "npm run build && node tools/serve.mjs",
		"typecheck": "tsc -p . --noEmit",
		"clean": "node -e \"import('node:fs').then(fs=>fs.rmSync('dist',{recursive:true,force:true}))\""
	},
	"devDependencies": {
		"typescript": ">=5.6.0"
	},
	"engines": {
		"node": ">=20"
	}
}
